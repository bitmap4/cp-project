\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Layer-wise probing: POS accuracy (blue), dep-depth $R^2$ (orange), RT binary accuracy (green), $\pm 1$ SD across 3-fold CV. POS peaks early (L3--4), dep-depth peaks mid (BERT L8, GPT-2 L6), RT peaks at L4. GPT-2 shows steeper late-layer collapse for all three probes.}}{5}{figure.caption.14}\protected@file@percent }
\newlabel{fig:probing}{{1}{5}{Layer-wise probing: POS accuracy (blue), dep-depth $R^2$ (orange), RT binary accuracy (green), $\pm 1$ SD across 3-fold CV. POS peaks early (L3--4), dep-depth peaks mid (BERT L8, GPT-2 L6), RT peaks at L4. GPT-2 shows steeper late-layer collapse for all three probes}{figure.caption.14}{}}
\newlabel{fig:pos_bert}{{2a}{5}{BERT L5: PCA reveals an annular structure; t-SNE separates 16 POS categories into distinct clusters, with PUNCT forming tight isolated groups and NOUN occupying the largest region}{figure.caption.16}{}}
\newlabel{sub@fig:pos_bert}{{a}{5}{BERT L5: PCA reveals an annular structure; t-SNE separates 16 POS categories into distinct clusters, with PUNCT forming tight isolated groups and NOUN occupying the largest region}{figure.caption.16}{}}
\newlabel{fig:pos_gpt2}{{2b}{5}{GPT-2 L4: PCA shows an elongated manifold with a function-word-to-content-word gradient; t-SNE clusters are comparably clean, with DET, ADP, and PRON forming particularly tight groups}{figure.caption.16}{}}
\newlabel{sub@fig:pos_gpt2}{{b}{5}{GPT-2 L4: PCA shows an elongated manifold with a function-word-to-content-word gradient; t-SNE clusters are comparably clean, with DET, ADP, and PRON forming particularly tight groups}{figure.caption.16}{}}
