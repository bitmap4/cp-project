\newlabel{fig:rt_bert}{{3a}{6}{BERT L5: PCA shows Q4 (slow) tokens tending toward the outer ring; t-SNE reveals a diffuse gradient with partial Q4 clustering in certain neighbourhoods}{figure.caption.18}{}}
\newlabel{sub@fig:rt_bert}{{a}{6}{BERT L5: PCA shows Q4 (slow) tokens tending toward the outer ring; t-SNE reveals a diffuse gradient with partial Q4 clustering in certain neighbourhoods}{figure.caption.18}{}}
\newlabel{fig:rt_gpt2}{{3b}{6}{GPT-2 L4: PCA displays a slight Q1--Q4 gradient along the primary axis; t-SNE shows more structured RT-homogeneous neighbourhoods than BERT}{figure.caption.18}{}}
\newlabel{sub@fig:rt_gpt2}{{b}{6}{GPT-2 L4: PCA displays a slight Q1--Q4 gradient along the primary axis; t-SNE shows more structured RT-homogeneous neighbourhoods than BERT}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces PCA and t-SNE projections coloured by reading-time quartile (Q1 = fast, Q4 = slow). Unlike POS tags (Figure~\ref {fig:pos}), RT quartiles produce a spatial gradient rather than discrete clusters, consistent with reading time being partially but not fully decodable from embeddings.}}{6}{figure.caption.18}\protected@file@percent }
\newlabel{fig:rt}{{3}{6}{PCA and t-SNE projections coloured by reading-time quartile (Q1 = fast, Q4 = slow). Unlike POS tags (Figure~\ref {fig:pos}), RT quartiles produce a spatial gradient rather than discrete clusters, consistent with reading time being partially but not fully decodable from embeddings}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces GPT-2 L4 embeddings coloured by surprisal quartile. PCA shows a clean gradient along PC1; t-SNE clusters high-surprisal tokens into distinct neighbourhoods. The surprisal structure is cleaner than the RT gradient (Figure~\ref {fig:rt_gpt2}), consistent with surprisal being a model-internal quantity.}}{6}{figure.caption.20}\protected@file@percent }
\newlabel{fig:surprisal}{{4}{6}{GPT-2 L4 embeddings coloured by surprisal quartile. PCA shows a clean gradient along PC1; t-SNE clusters high-surprisal tokens into distinct neighbourhoods. The surprisal structure is cleaner than the RT gradient (Figure~\ref {fig:rt_gpt2}), consistent with surprisal being a model-internal quantity}{figure.caption.20}{}}
